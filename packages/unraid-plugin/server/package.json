{
  "name": "@unraidclaw/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --dts --clean --external @unraidclaw/shared",
    "bundle": "tsup src/index.ts --format cjs --target node22 --clean --no-splitting --config tsup.bundle.mjs",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@unraidclaw/shared": "workspace:*",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.2.0",
    "unraidclaw": "workspace:*",
    "ajv": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
