  {
   "Name": "MeshVault",
   "Repository": "ghcr.io/007darkmatter5/meshvault:latest",
   "Registry": "https://github.com/007darkmatter5/meshvault/pkgs/container/meshvault",
   "Repo": "Darkmatter5's Repository",
   "Overview": "A self-hosted catalog for a 3D printing model collection.\n\n    Indexes your model folders in place - files are never moved or renamed unless you\n    allow it - and adds search, tag",
   "Icon": "https://raw.githubusercontent.com/007darkmatter5/meshvault/main/templates/meshvault.png",
   "Support": "https://github.com/007darkmatter5/meshvault/issues",
   "Project": "https://github.com/007darkmatter5/meshvault",
   "WebUI": "http://[IP]:[PORT:8080]/",
   "Network": "bridge",
   "Shell": "bash",
   "Privileged": "false",
   "TemplateURL": "https://raw.githubusercontent.com/007darkmatter5/meshvault/main/templates/meshvault.xml",
   "CategoryList": [
    "MediaApp-Other",
    "Productivity"
   ],
   "Config": [
    {
     "@attributes": {
      "Name": "WebUI Port",
      "Target": "8080",
      "Default": "8080",
      "Mode": "tcp",
      "Description": "Port for the MeshVault web interface.",
      "Type": "Port",
      "Display": "always",
      "Required": "true",
      "Mask": "false"
     },
     "value": "8080"
    },
    {
     "@attributes": {
      "Name": "App Data",
      "Target": "/data",
      "Default": "/mnt/user/appdata/meshvault",
      "Mode": "rw",
      "Description": "Database, thumbnails, 3D preview cache and sign-in keys. Put this on cache or an SSD - SQLite over a network share is unreliable. Back it up: it holds your tags, collections and notes.",
      "Type": "Path",
      "Display": "always",
      "Required": "true",
      "Mask": "false"
     },
     "value": "/mnt/user/appdata/meshvault"
    },
    {
     "@attributes": {
      "Name": "Model Library",
      "Target": "/models",
      "Default": "/mnt/user/models",
      "Mode": "ro",
      "Description": "Your 3D model folder. Mounted read-only by default so MeshVault can never touch your files. Change to rw only if you want it to organise them for you.",
      "Type": "Path",
      "Display": "always",
      "Required": "true",
      "Mask": "false"
     },
     "value": "/mnt/user/models"
    },
    {
     "@attributes": {
      "Name": "Library Name",
      "Target": "MeshVault__Libraries__0__Name",
      "Default": "Models",
      "Mode": "",
      "Description": "Name shown for the library above.",
      "Type": "Variable",
      "Display": "always",
      "Required": "false",
      "Mask": "false"
     },
     "value": "Models"
    },
    {
     "@attributes": {
      "Name": "Library Path",
