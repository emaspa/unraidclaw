{
  "id": "unraidclaw",
  "contracts": {
    "tools": [
      "unraid_array_start",
      "unraid_array_status",
      "unraid_array_stop",
      "unraid_disk_details",
      "unraid_disk_list",
      "unraid_docker_create",
      "unraid_docker_inspect",
      "unraid_docker_list",
      "unraid_docker_logs",
      "unraid_docker_pause",
      "unraid_docker_remove",
      "unraid_docker_restart",
      "unraid_docker_start",
      "unraid_docker_stop",
      "unraid_docker_unpause",
      "unraid_health_check",
      "unraid_network_info",
      "unraid_notification_archive",
      "unraid_notification_create",
      "unraid_notification_delete",
      "unraid_notification_list",
      "unraid_parity_cancel",
      "unraid_parity_pause",
      "unraid_parity_resume",
      "unraid_parity_start",
      "unraid_parity_status",
      "unraid_service_list",
      "unraid_share_details",
      "unraid_share_list",
      "unraid_share_update",
      "unraid_syslog",
      "unraid_system_info",
      "unraid_system_metrics",
      "unraid_system_reboot",
      "unraid_system_shutdown",
      "unraid_user_me",
      "unraid_vm_force_stop",
      "unraid_vm_inspect",
      "unraid_vm_list",
      "unraid_vm_pause",
      "unraid_vm_reboot",
      "unraid_vm_resume",
      "unraid_vm_start",
      "unraid_vm_stop"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "serverUrl": {
        "type": "string",
        "description": "URL of the UnraidClaw server (single-server mode)"
      },
      "apiKey": {
        "type": "string",
        "description": "API key for authenticating with UnraidClaw (single-server mode)"
      },
      "tlsSkipVerify": {
        "type": "boolean",
        "description": "Skip TLS certificate verification (for self-signed certs)",
        "default": false
      },
      "servers": {
        "type": "array",
        "description": "Multiple UnraidClaw servers (multi-server mode)",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Server name used to target this server in tool calls"
            },
            "serverUrl": {
              "type": "string",
              "description": "URL of the UnraidClaw server"
            },
            "apiKey": {
              "type": "string",
              "description": "API key for authenticating with this server"
            },
            "tlsSkipVerify": {
              "type": "boolean",
              "description": "Skip TLS certificate verification",
              "default": false
            },
            "default": {
              "type": "boolean",
              "description": "Use this server when no server name is specified"
            }
          },
          "required": ["name", "serverUrl", "apiKey"]
        }
      }
    }
  },
  "uiHints": {
    "serverUrl": {
      "label": "Server URL",
      "placeholder": "https://192.168.1.100:9876"
    },
    "apiKey": {
      "label": "API Key",
      "sensitive": true
    },
    "tlsSkipVerify": {
      "label": "Skip TLS Verification"
    }
  }
}
